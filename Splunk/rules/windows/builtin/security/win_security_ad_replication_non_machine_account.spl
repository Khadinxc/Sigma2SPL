# Title: Active Directory Replication from Non Machine Account - DcSync Indicator
# Author: Roberto Rodriguez @Cyb3rWard0g
# Date: 2019-07-26
# Level: medium
# Description: Detects potential abuse of Active Directory Replication Service (ADRS) from a non machine account to request credentials.
# MITRE Tactic: Credential Access
# Tags: attack.credential-access, attack.t1003.006
# Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/builtin/security/win_security_ad_replication_non_machine_account.yml

EventID=4662 Properties IN ("*1131f6ad-9c07-11d1-f79f-00c04fc2dcd2*", "*1131f6aa-9c07-11d1-f79f-00c04fc2dcd2*", "*9923a32a-3607-11d2-b9be-0000f87a36b2*", "*89e95b76-444d-4c62-991a-0facbeda640c*") NOT SubjectUserName="*$" NOT (SubjectDomainName="Window Manager" OR SubjectUserName IN ("NT AUT*", "MSOL_*"))