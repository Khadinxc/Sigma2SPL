```
Title: Security Tools Keyword Lookup Via Findstr.EXE
Author: Nasreddine Bencherchali (Nextron Systems), frack113, MalGamy (Nextron Systems)
Date: 2023-10-20
Level: medium
Description: Detects execution of "findstr" or "find" to search for common names of security tools. Attackers often pipe the results of recon commands such as "tasklist" or "whoami" to "findstr" in order to filter out the results.
 This detection focuses on the keywords that the attacker might use as a filter.
MITRE Tactic: Discovery
Tags: attack.discovery, attack.t1518.001
Reference: https://github.com/SigmaHQ/sigma/blob/master/rules/windows/process_creation/proc_creation_win_findstr_security_keyword_lookup.yml
```
Image IN ("*\\find.exe", "*\\findstr.exe") OR OriginalFileName IN ("FIND.EXE", "FINDSTR.EXE") CommandLine IN ("* aswidsagent *", "* aswidsagent\"*", "* avast *", "* avast\"*", "* avastui *", "* avastui\"*", "* avg *", "* avg\"*", "* avgui *", "* avgui\"*", "* avira *", "* avira\"*", "* avp *", "* avp\"*", "* bdagent *", "* bdagent\"*", "* bdservicehost *", "* bdservicehost\"*", "* bitdefender *", "* bitdefender\"*", "* cb *", "* cb\"*", "* cbdefense *", "* cbdefense\"*", "* ccsvchst *", "* ccsvchst\"*", "* carbonblack *", "* carbonblack\"*", "* checkpoint *", "* checkpoint\"*", "* cisco *", "* cisco\"*", "* coreframeworkhost *", "* coreframeworkhost\"*", "* cortex *", "* cortex\"*", "* crow *", "* crow\"*", "* csagent *", "* csagent\"*", "* csfalcon *", "* csfalcon\"*", "* cylance *", "* cylance\"*", "* cylancesvc *", "* cylancesvc\"*", "* cylanceui *", "* cylanceui\"*", "* cyserver *", "* cyserver\"*", "* cytray *", "* cytray\"*", "* cyvera *", "* cyvera\"*", "* defender *", "* defender\"*", "* elastic *", "* elastic\"*", "* egui *", "* egui\"*", "* ekrn *", "* ekrn\"*", "* endpoint *", "* endpoint\"*", "* eset *", "* eset\"*", "* falcon *", "* falcon\"*", "* falconagent *", "* falconagent\"*", "* fireeye *", "* fireeye\"*", "* forticlient *", "* forticlient\"*", "* fortinet *", "* fortinet\"*", "* kaspersky *", "* kaspersky\"*", "* kes *", "* kes\"*", "* ksde *", "* ksde\"*", "* malw *", "* malw\"*", "* mbam *", "* mbam\"*", "* mbamservice *", "* mbamservice\"*", "* mbamtray *", "* mbamtray\"*", "* mcafee *", "* mcafee\"*", "* mc *", "* mc\"*", "* mcshield *", "* mcshield\"*", "* mfeann *", "* mfeann\"*", "* mfemms *", "* mfemms\"*", "* mpdefender *", "* mpdefender\"*", "* mpcmdrun *", "* mpcmdrun\"*", "* mssense *", "* mssense\"*", "* msmpeng *", "* msmpeng\"*", "* norton *", "* norton\"*", "* nortonsecurity *", "* nortonsecurity\"*", "* nswscsvc *", "* nswscsvc\"*", "* opssvc *", "* opssvc\"*", "* paloalto *", "* paloalto\"*", "* qualys *", "* qualys\"*", "* rap